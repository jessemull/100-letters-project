    "@types/node": "^26.1.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/react-google-recaptcha": "^2.1.9",
    "commitizen": "^4.3.2",
    "cookie-parser": "^1.4.7",
    "cypress": "^15.20.0",
    "cz-conventional-changelog": "^3.3.0",
    "dotenv": "^17.4.2",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.3.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-prettier": "^5.5.6",
    "eslint-plugin-unused-imports": "^4.4.1",
    "execa": "^10.0.1",
    "express": "^5.2.1",
    "fishery": "^2.4.0",
    "http-proxy-middleware": "^4.2.0",
    "husky": "^9.1.7",
    "identity-obj-proxy": "^3.0.0",
    "jest": "^30.4.2",
    "jest-axe": "^11.0.0",
    "jest-environment-jsdom": "^30.4.1",
    "lighthouse": "^12.8.2",
    "lint-staged": "^17.3.0",
    "next-sitemap": "^4.2.3",
    "node-fetch": "^3.3.2",
    "postcss": "^8.5.25",
    "prettier": "^3.9.6",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "wait-on": "^9.1.0"
  },
  "engines": {
    "node": ">=26"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx,mjs,cjs}": [
      "eslint --fix"
    ],
    "*.{json,css,md}": [
      "prettier --write"
    ]
  },
  "name": "100-letters-project",
  "private": true,
  "scripts": {
    "bastion": "node ./scripts/connect.js",
    "build": "ENABLE_SOURCE_MAPS=false NODE_ENV=${NODE_ENV:-test} next build",
    "commit": "git-cz",
    "coverage:open": "open ./coverage/lcov-report/index.html",
    "dev": "next dev",
    "e2e": "cypress run",
    "format": "prettier --write .",
    "lighthouse": "lhci autorun",
    "lint": "eslint . --fix",
    "postbuild": "next-sitemap",
    "postsource-maps": "node ./scripts/source-maps.js",
    "prebuild": "NODE_ENV=${NODE_ENV:-test} node ./scripts/prebuild.js",
    "predev": "npm run prebuild -- --no-refresh",
    "prepare": "husky",
    "proxy": "node ./proxy/index.js",
    "source-maps": "ENABLE_SOURCE_MAPS=true NODE_ENV=${NODE_ENV:-test} next build",
    "start": "echo 'Production hosting serves the static out/ directory (S3/CloudFront). Use npm run build then serve out/, or npm run dev for local development.' && exit 1",
    "test": "jest --coverage",
    "test:watch": "jest --watch",
    "token": "node ./scripts/cognito-token.js",
    "typecheck": "tsc --noEmit"
  },
  "version": "0.1.0"
}
